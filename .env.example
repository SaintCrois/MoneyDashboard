POSTGRES_DB=investment_radar
POSTGRES_USER=radar_user
POSTGRES_PASSWORD=change_this_password

DATABASE_URL=postgresql://radar_user:change_this_password@localhost:5432/investment_radar

BACKEND_URL=http://localhost:8000

